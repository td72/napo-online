# Managed by Ansible — do not edit by hand. Edit deploy/ansible/inventory.yml.
# {{ ansible_managed }}

# --- 必須 ---
NAPO_BIND=127.0.0.1:8080
NAPO_DB={{ napo_db_path }}
NAPO_CF_TEAM={{ napo_cf_team }}
NAPO_CF_AUD={{ napo_cf_aud }}

# --- 任意 ---
NAPO_STATIC={{ napo_static_dir }}
NAPO_DEV_MODE={{ napo_dev_mode | string | lower }}
NAPO_LOG={{ napo_log }}
NAPO_MAX_ROOMS={{ napo_max_rooms }}

# --- セット構成 ---
NAPO_HANDS_PER_MATCH={{ napo_hands_per_match }}

# --- 切断/離席タイマー(ミリ秒)---
NAPO_T1_DETECT_MS={{ napo_t1_detect_ms }}
NAPO_T2_NOTIFY_MS={{ napo_t2_notify_ms }}
NAPO_T3_ABORT_MS={{ napo_t3_abort_ms }}
NAPO_T4_END_MS={{ napo_t4_end_ms }}

# --- 安全性 ---
NAPO_WS_MAX_MSG_BYTES={{ napo_ws_max_msg_bytes }}
NAPO_WS_RATE_LIMIT_PER_SEC={{ napo_ws_rate_limit_per_sec }}
