# Managed by Ansible — do not edit by hand.
# {{ ansible_managed }}

# Cloudflare Origin Certificate を使う(ACME は CF Proxy + UFW CF allowlist の制約で
# 使えない)。CF SSL/TLS Mode を "Full (strict)" に設定する前提。

{
    # ACME を完全に無効化(LE/ZeroSSL ともに使わない)
    auto_https off
    # admin off
}

{{ napo_domain }}:443 {
    tls {{ napo_tls_cert_path }} {{ napo_tls_key_path }}

    encode zstd gzip

    reverse_proxy 127.0.0.1:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /var/log/caddy/napo.access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
