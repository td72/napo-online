# /etc/napo/napo.env  (chmod 640, owner root:napo)
#
# napo.service が EnvironmentFile= で読み込む。
# 値は docs/server-implementation-guide.md §9.1 を参照。

# --- 必須 ---
NAPO_BIND=127.0.0.1:8080
NAPO_DB=/var/lib/napo/game.db
NAPO_CF_TEAM=tedsum.cloudflareaccess.com
NAPO_CF_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意 ---
# Vite ビルド成果物(`mise run deploy:web` で /opt/napo/dist/ に同期される)。
# 設定しないと Rust 側は静的配信を行わず、/api・/ws のみが応答する。
NAPO_STATIC=/opt/napo/dist
NAPO_DEV_MODE=false
NAPO_LOG=info,napo_online=info
NAPO_MAX_ROOMS=64

# --- セット構成 ---
NAPO_HANDS_PER_MATCH=10

# --- 切断/離席タイマー(ミリ秒) ---
NAPO_T1_DETECT_MS=60000
NAPO_T2_NOTIFY_MS=5000
NAPO_T3_ABORT_MS=300000
NAPO_T4_END_MS=600000

# --- 安全性 ---
NAPO_WS_MAX_MSG_BYTES=8192
NAPO_WS_RATE_LIMIT_PER_SEC=10
